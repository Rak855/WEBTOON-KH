rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'chongmakio863@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/site/team)
        && request.auth.token.email in get(/databases/$(database)/documents/site/team).data.adminEmails
      );
    }

    function isModerator() {
      return isAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/site/team)
        && request.auth.token.email in get(/databases/$(database)/documents/site/team).data.moderatorEmails
      );
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'preferredLang', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'preferredLang', 'bio', 'dailyGoal', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 65536
        && data.preferredLang in ['kh', 'en']
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('dailyGoal' in data) || (data.dailyGoal is int && data.dailyGoal >= 1 && data.dailyGoal <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReadingState(data, userId) {
      return data.keys().hasAll(['uid', 'subscribedIds', 'likedEpisodeIds', 'readEpisodeIds', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'subscribedIds', 'likedEpisodeIds', 'readEpisodeIds', 'dailyProgressDate', 'dailyReadEpisodeIds', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId && data.uid == request.auth.uid
        && data.subscribedIds is list && data.subscribedIds.size() <= 100
        && (data.subscribedIds.size() == 0 || data.subscribedIds[0] is string)
        && data.likedEpisodeIds is list && data.likedEpisodeIds.size() <= 200
        && (data.likedEpisodeIds.size() == 0 || data.likedEpisodeIds[0] is string)
        && data.readEpisodeIds is list && data.readEpisodeIds.size() <= 200
        && (data.readEpisodeIds.size() == 0 || data.readEpisodeIds[0] is string)
        && (!('dailyProgressDate' in data) || (data.dailyProgressDate is string && data.dailyProgressDate.size() == 10 && data.dailyProgressDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('dailyReadEpisodeIds' in data) || (data.dailyReadEpisodeIds is list && data.dailyReadEpisodeIds.size() <= 100 && (data.dailyReadEpisodeIds.size() == 0 || data.dailyReadEpisodeIds[0] is string)))
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'announcementEnabled',
          'announcementKh',
          'announcementEn',
          'announcementTone',
          'canvasSubmissionsEnabled',
          'hiddenSeriesIds',
          'featuredSeriesIds',
          'updatedBy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'announcementEnabled',
          'announcementKh',
          'announcementEn',
          'announcementTone',
          'canvasSubmissionsEnabled',
          'hiddenSeriesIds',
          'featuredSeriesIds',
          'updatedBy',
          'updatedAt'
        ])
        && data.announcementEnabled is bool
        && data.announcementKh is string && data.announcementKh.size() <= 200
        && data.announcementEn is string && data.announcementEn.size() <= 200
        && data.announcementTone in ['emerald', 'amber', 'slate']
        && data.canvasSubmissionsEnabled is bool
        && data.hiddenSeriesIds is list && data.hiddenSeriesIds.size() <= 100
        && (data.hiddenSeriesIds.size() == 0 || data.hiddenSeriesIds[0] is string)
        && data.featuredSeriesIds is list && data.featuredSeriesIds.size() <= 20
        && (data.featuredSeriesIds.size() == 0 || data.featuredSeriesIds[0] is string)
        && data.updatedBy is string && data.updatedBy.size() <= 254 && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    function isValidSiteTeam(data) {
      return data.keys().hasAll(['adminEmails', 'moderatorEmails', 'displayNames', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['adminEmails', 'moderatorEmails', 'displayNames', 'updatedBy', 'updatedAt'])
        && data.adminEmails is list && data.adminEmails.size() <= 25
        && (data.adminEmails.size() == 0 || data.adminEmails[0] is string)
        && data.moderatorEmails is list && data.moderatorEmails.size() <= 50
        && (data.moderatorEmails.size() == 0 || data.moderatorEmails[0] is string)
        && data.displayNames is map && data.displayNames.size() <= 75
        && data.updatedBy is string && data.updatedBy.size() >= 3 && data.updatedBy.size() <= 254 && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    function isValidStaffRole(data, staffId) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'addedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'note', 'addedBy', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id) && data.id == staffId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email != 'chongmakio863@gmail.com'
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['admin', 'moderator']
        && (!('note' in data) || (data.note is string && data.note.size() <= 200))
        && data.addedBy is string && data.addedBy.size() >= 3 && data.addedBy.size() <= 254 && data.addedBy == request.auth.token.email
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data, logId) {
      return data.keys().hasAll(['id', 'actorEmail', 'actorName', 'actorRole', 'category', 'action', 'targetLabel', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorEmail', 'actorName', 'actorRole', 'category', 'action', 'targetId', 'targetLabel', 'details', 'createdAt'])
        && data.id is string && isValidId(data.id) && data.id == logId
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254 && data.actorEmail == request.auth.token.email
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100
        && data.actorRole in ['super_admin', 'admin', 'moderator']
        && (
          (data.actorRole == 'super_admin' && isSuperAdmin())
          || (data.actorRole == 'admin' && isAdmin())
          || (data.actorRole == 'moderator' && isModerator())
        )
        && data.category in ['staff', 'series', 'episode', 'comment', 'ads', 'settings']
        && data.action in [
          'staff_added',
          'staff_role_changed',
          'staff_removed',
          'series_created',
          'series_updated',
          'series_deleted',
          'series_hidden',
          'series_restored',
          'series_featured',
          'series_unfeatured',
          'series_reordered',
          'episode_added',
          'episode_updated',
          'episode_deleted',
          'comment_deleted',
          'ad_created',
          'ad_updated',
          'ad_toggled',
          'ad_deleted',
          'ads_settings_updated',
          'settings_updated',
          'settings_reset'
        ]
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 160
        && (!('details' in data) || (data.details is string && data.details.size() <= 300))
        && data.createdAt is timestamp;
    }

    function isValidAdsterraConfig(adsterra) {
      return adsterra is map
        && adsterra.keys().hasAll(['enabled', 'displayMode', 'units'])
        && adsterra.keys().hasOnly(['enabled', 'displayMode', 'units'])
        && adsterra.enabled is bool
        && adsterra.displayMode in ['backfill', 'coexist', 'primary']
        && adsterra.units is list
        && adsterra.units.size() <= 10
        && (
          adsterra.units.size() == 0
          || (
            adsterra.units[0] is map
            && adsterra.units[0].keys().hasAll(['id', 'name', 'format', 'placement', 'isActive'])
            && adsterra.units[0].keys().hasOnly([
              'id',
              'name',
              'format',
              'placement',
              'scriptSrc',
              'zoneKey',
              'containerId',
              'width',
              'height',
              'directUrl',
              'isActive',
              'updatedAtMs'
            ])
            && adsterra.units[0].id is string
            && adsterra.units[0].id.size() > 0
            && adsterra.units[0].id.size() <= 64
            && adsterra.units[0].name is string
            && adsterra.units[0].name.size() > 0
            && adsterra.units[0].name.size() <= 80
            && adsterra.units[0].format in ['banner', 'native_banner', 'social_bar', 'popunder', 'direct_link']
            && adsterra.units[0].placement in ['home_banner', 'discovery_inline', 'reader_footer', 'global_script']
            && (!('scriptSrc' in adsterra.units[0]) || (adsterra.units[0].scriptSrc is string && adsterra.units[0].scriptSrc.size() <= 500))
            && (!('zoneKey' in adsterra.units[0]) || (adsterra.units[0].zoneKey is string && adsterra.units[0].zoneKey.size() <= 128))
            && (!('containerId' in adsterra.units[0]) || (adsterra.units[0].containerId is string && adsterra.units[0].containerId.size() <= 128))
            && (!('directUrl' in adsterra.units[0]) || (adsterra.units[0].directUrl is string && adsterra.units[0].directUrl.size() <= 500))
            && (!('width' in adsterra.units[0]) || (adsterra.units[0].width is int && adsterra.units[0].width >= 0 && adsterra.units[0].width <= 2000))
            && (!('height' in adsterra.units[0]) || (adsterra.units[0].height is int && adsterra.units[0].height >= 0 && adsterra.units[0].height <= 2000))
            && adsterra.units[0].isActive is bool
          )
        );
    }

    function isValidAdskeeperConfig(adskeeper) {
      return adskeeper is map
        && adskeeper.keys().hasAll(['enabled', 'displayMode', 'units'])
        && adskeeper.keys().hasOnly(['enabled', 'displayMode', 'units'])
        && adskeeper.enabled is bool
        && adskeeper.displayMode in ['backfill', 'coexist', 'primary']
        && adskeeper.units is list
        && adskeeper.units.size() <= 10
        && (
          adskeeper.units.size() == 0
          || (
            adskeeper.units[0] is map
            && adskeeper.units[0].keys().hasAll(['id', 'name', 'format', 'placement', 'isActive'])
            && adskeeper.units[0].keys().hasOnly([
              'id',
              'name',
              'format',
              'placement',
              'scriptSrc',
              'widgetId',
              'rootId',
              'directUrl',
              'isActive',
              'updatedAtMs'
            ])
            && adskeeper.units[0].id is string
            && adskeeper.units[0].id.size() > 0
            && adskeeper.units[0].id.size() <= 64
            && adskeeper.units[0].name is string
            && adskeeper.units[0].name.size() > 0
            && adskeeper.units[0].name.size() <= 80
            && adskeeper.units[0].format in ['native_widget', 'under_article', 'in_feed_banner', 'smart_widget', 'direct_link']
            && adskeeper.units[0].placement in ['home_banner', 'discovery_inline', 'reader_footer', 'global_script']
            && (!('scriptSrc' in adskeeper.units[0]) || (adskeeper.units[0].scriptSrc is string && adskeeper.units[0].scriptSrc.size() <= 500))
            && (!('widgetId' in adskeeper.units[0]) || (adskeeper.units[0].widgetId is string && adskeeper.units[0].widgetId.size() <= 64))
            && (!('rootId' in adskeeper.units[0]) || (adskeeper.units[0].rootId is string && adskeeper.units[0].rootId.size() <= 128))
            && (!('directUrl' in adskeeper.units[0]) || (adskeeper.units[0].directUrl is string && adskeeper.units[0].directUrl.size() <= 500))
            && (!('updatedAtMs' in adskeeper.units[0]) || adskeeper.units[0].updatedAtMs is int)
            && adskeeper.units[0].isActive is bool
          )
        );
    }

    function isValidAdsenseConfig(adsense) {
      return adsense is map
        && adsense.keys().hasAll(['enabled', 'publisherId', 'autoAdsEnabled', 'displayMode', 'units'])
        && adsense.keys().hasOnly(['enabled', 'publisherId', 'autoAdsEnabled', 'displayMode', 'units'])
        && adsense.enabled is bool
        && adsense.autoAdsEnabled is bool
        && adsense.publisherId is string
        && adsense.publisherId.size() <= 40
        && adsense.displayMode in ['backfill', 'coexist', 'primary']
        && adsense.units is list
        && adsense.units.size() <= 10
        && (
          adsense.units.size() == 0
          || (
            adsense.units[0] is map
            && adsense.units[0].keys().hasAll(['id', 'name', 'slotId', 'format', 'placement', 'sizeMode', 'isActive'])
            && adsense.units[0].keys().hasOnly([
              'id',
              'name',
              'slotId',
              'format',
              'placement',
              'sizeMode',
              'width',
              'height',
              'fullWidthResponsive',
              'isActive',
              'updatedAtMs'
            ])
            && adsense.units[0].id is string
            && adsense.units[0].id.size() > 0
            && adsense.units[0].id.size() <= 64
            && adsense.units[0].name is string
            && adsense.units[0].name.size() > 0
            && adsense.units[0].name.size() <= 80
            && adsense.units[0].slotId is string
            && adsense.units[0].slotId.size() > 0
            && adsense.units[0].slotId.size() <= 40
            && adsense.units[0].format in ['display', 'in_feed', 'in_article', 'multiplex']
            && adsense.units[0].placement in ['home_banner', 'discovery_inline', 'reader_footer']
            && adsense.units[0].sizeMode in ['responsive', 'fixed']
            && (!('width' in adsense.units[0]) || (adsense.units[0].width is int && adsense.units[0].width >= 0 && adsense.units[0].width <= 2000))
            && (!('height' in adsense.units[0]) || (adsense.units[0].height is int && adsense.units[0].height >= 0 && adsense.units[0].height <= 2000))
            && (!('fullWidthResponsive' in adsense.units[0]) || adsense.units[0].fullWidthResponsive is bool)
            && (!('updatedAtMs' in adsense.units[0]) || adsense.units[0].updatedAtMs is int)
            && adsense.units[0].isActive is bool
          )
        );
    }

    function isValidSiteAds(data) {
      return data.keys().hasAll(['adsEnabled', 'campaigns', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['adsEnabled', 'campaigns', 'adsterra', 'adskeeper', 'adsense', 'updatedBy', 'updatedAt'])
        && data.adsEnabled is bool
        && data.campaigns is list
        && data.campaigns.size() <= 15
        && (
          data.campaigns.size() == 0
          || (
            data.campaigns[0] is map
            && data.campaigns[0].keys().hasAll(['id', 'sponsorName', 'titleKh', 'titleEn', 'targetUrl', 'placement', 'isActive'])
            && data.campaigns[0].id is string
            && data.campaigns[0].id.size() > 0
            && data.campaigns[0].id.size() <= 64
            && data.campaigns[0].sponsorName is string
            && data.campaigns[0].sponsorName.size() > 0
            && data.campaigns[0].sponsorName.size() <= 80
            && data.campaigns[0].targetUrl is string
            && data.campaigns[0].targetUrl.size() <= 500
          )
        )
        && (!('adsterra' in data) || isValidAdsterraConfig(data.adsterra))
        && (!('adskeeper' in data) || isValidAdskeeperConfig(data.adskeeper))
        && (!('adsense' in data) || isValidAdsenseConfig(data.adsense))
        && data.updatedBy is string
        && data.updatedBy.size() >= 3
        && data.updatedBy.size() <= 254
        && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/info {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLang', 'bio', 'dailyGoal', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /users/{userId}/private/readingState {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidReadingState(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidReadingState(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['subscribedIds', 'likedEpisodeIds', 'readEpisodeIds', 'dailyProgressDate', 'dailyReadEpisodeIds', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /site/config {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && isValidSiteConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidSiteConfig(incoming())
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'announcementEnabled',
            'announcementKh',
            'announcementEn',
            'announcementTone',
            'canvasSubmissionsEnabled',
            'hiddenSeriesIds',
            'featuredSeriesIds',
            'updatedBy',
            'updatedAt'
          ])) ||
          (isModerator() && incoming().diff(existing()).affectedKeys().hasOnly([
            'hiddenSeriesIds',
            'updatedBy',
            'updatedAt'
          ]))
        );
      allow delete: if false;
    }

    match /site/ads {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && isValidSiteAds(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidSiteAds(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['adsEnabled', 'campaigns', 'adsterra', 'adskeeper', 'adsense', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /site/team {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin()
        && isValidSiteTeam(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidSiteTeam(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'adminEmails',
          'moderatorEmails',
          'displayNames',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /staffRoles/{staffId} {
      allow get: if isValidId(staffId)
        && isVerifiedUser()
        && (isAdmin() || (resource != null && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedUser()
        && (isSuperAdmin() || resource.data.email == request.auth.token.email);
      allow create: if isValidId(staffId)
        && isAdmin()
        && isValidStaffRole(incoming(), staffId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(staffId)
        && isAdmin()
        && isValidStaffRole(incoming(), staffId)
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'note', 'addedBy', 'updatedAt']);
      allow delete: if isValidId(staffId) && isAdmin();
    }

    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && isModerator();
      allow list: if isModerator();
      allow create: if isValidId(logId)
        && isModerator()
        && isValidActivityLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isSuperAdmin();
    }
  }
}
